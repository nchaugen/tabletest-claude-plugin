{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_015Ty7jfU83F1upSA3PtSirp","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VTbvko8yGSZUGi3kv2amg1","name":"Write","input":{"file_path":"/var/folders/fz/zxx_qbvj49gbql83cc5l47pr0000gn/T/eval-skill-1775508642173/OrderSplittingTest.java","content":"import org.tabletest.junit.Description;\nimport org.tabletest.junit.TableTest;\nimport org.tabletest.junit.TypeConverter;\nimport org.junit.jupiter.api.DisplayName;\n\nimport java.util.*;\nimport java.util.stream.*;\n\nimport static com.example.FulfillmentType.*;\nimport static com.example.ShipmentTiming.*;\nimport static java.util.stream.Collectors.*;\nimport static org.junit.jupiter.api.Assertions.*;\n\n/**\n * Tests for OrderSplitter.splitOrder(Order, WarehouseInventory).\n *\n * Type converters and domain constructors assume:\n *   Order(List<OrderItem>)\n *   OrderItem(productId, quantity, FulfillmentType, deliveryAddress, companionGroupId)\n *   WarehouseInventory(Map<String, Map<String, StockLevel>>)\n *   StockLevel.inStock(int), StockLevel.backordered(), StockLevel.preOrder()\n *   Shipment.getFulfillmentType(), .getDeliveryAddress(), .getTiming(),\n *           .getWarehouseId(), .getItems()\n * Adapt these calls to the actual API as needed.\n */\npublic class OrderSplittingTest {\n\n    private final OrderSplitter splitter = new OrderSplitter();\n\n    // -------------------------------------------------------------------------\n    // Separate delivery from pickup\n    // -------------------------------------------------------------------------\n\n    @DisplayName(\"Separate delivery from pickup\")\n    @Description(\"\"\"\n            Items with different fulfillment types always go in separate shipments,\n            regardless of delivery address or warehouse.\n            Inventory is a single fully-stocked warehouse (WH1) for all rows —\n            availability and warehouse selection do not vary here.\n            \"\"\")\n    @TableTest(\"\"\"\n            Scenario                              | Items                                                                       | Delivery shipments? | Pickup shipments?\n            All delivery, same address            | PROD-A/DELIVERY/Main-St, PROD-B/DELIVERY/Main-St                            | 1                   | 0\n            All pickup                            | PROD-A/PICKUP, PROD-B/PICKUP                                                | 0                   | 1\n            One delivery and one pickup           | PROD-A/DELIVERY/Main-St, PROD-B/PICKUP                                      | 1                   | 1\n            Multiple of each type                 | PROD-A/DELIVERY/Main-St, PROD-B/DELIVERY/Main-St, PROD-C/PICKUP, PROD-D/PICKUP | 1                | 1\n            \"\"\")\n    void separatesDeliveryFromPickup(Order order, int deliveryShipments, int pickupShipments) {\n        List<Shipment> shipments = splitter.splitOrder(order, fullyStocked(order));\n        assertAll(\n            () -> assertEquals(deliveryShipments, countByType(shipments, DELIVERY)),\n            () -> assertEquals(pickupShipments,   countByType(shipments, PICKUP))\n        );\n    }\n\n    // -------------------------------------------------------------------------\n    // Separate by delivery address\n    // -------------------------------------------------------------------------\n\n    @DisplayName(\"Separate by delivery address\")\n    @Description(\"\"\"\n            DELIVERY items going to different addresses go in separate shipments.\n            All items use DELIVERY fulfillment. Inventory is a single fully-stocked\n            warehouse — availability and warehouse selection do not vary here.\n            \"\"\")\n    @TableTest(\"\"\"\n            Scenario                              | Items                                                                              | Delivery addresses?\n            Two items, same address               | PROD-A/DELIVERY/Main-St, PROD-B/DELIVERY/Main-St                                   | [Main-St]\n            Two items, different addresses        | PROD-A/DELIVERY/Main-St, PROD-B/DELIVERY/Oak-Ave                                   | [Main-St, Oak-Ave]\n            Three items, three addresses          | PROD-A/DELIVERY/Main-St, PROD-B/DELIVERY/Oak-Ave, PROD-C/DELIVERY/Pine-Rd          | [Main-St, Oak-Ave, Pine-Rd]\n            Two same address, one different       | PROD-A/DELIVERY/Main-St, PROD-B/DELIVERY/Main-St, PROD-C/DELIVERY/Oak-Ave          | [Main-St, Oak-Ave]\n            \"\"\")\n    void separatesByDeliveryAddress(Order order, List<String> deliveryAddresses) {\n        List<Shipment> shipments = splitter.splitOrder(order, fullyStocked(order));\n        List<String> actual = shipments.stream()\n                .map(Shipment::getDeliveryAddress)\n                .filter(Objects::nonNull)\n                .sorted()\n                .toList();\n        assertEquals(deliveryAddresses.stream().sorted().toList(), actual);\n    }\n\n    // -------------------------------------------------------------------------\n    // Ship in-stock items immediately\n    // -------------------------------------------------------------------------\n\n    @DisplayName(\"Ship in-stock items immediately\")\n    @Description(\"\"\"\n            In-stock items ship immediately; backordered and pre-ordered items ship\n            when available. In-stock items are never held back for deferred items.\n            All items in this table are DELIVERY to Main-St from a single warehouse\n            (WH1) — fulfillment type, address, and warehouse selection do not vary.\n            Open: if ordered quantity exceeds in-stock quantity, is the item treated\n            as fully backordered or does it partially split?\n            \"\"\")\n    @TableTest(\"\"\"\n            Scenario                              | Inventory                                         | Immediate items?  | Deferred items?\n            All in-stock                          | WH1:PROD-A=5 PROD-B=3                             | [PROD-A, PROD-B]  | []\n            All backordered                       | WH1:PROD-A=backordered PROD-B=backordered         | []                | [PROD-A, PROD-B]\n            In-stock not held for backordered     | WH1:PROD-A=5 PROD-B=backordered                   | [PROD-A]          | [PROD-B]\n            Pre-ordered treated as deferred       | WH1:PROD-A=5 PROD-B=preorder                      | [PROD-A]          | [PROD-B]\n            All pre-ordered                       | WH1:PROD-A=preorder PROD-B=preorder               | []                | [PROD-A, PROD-B]\n            \"\"\")\n    void shipsInStockItemsImmediately(WarehouseInventory inventory,\n                                      List<String> immediateItems,\n                                      List<String> deferredItems) {\n        Order order = twoItemDeliveryOrder();\n        List<Shipment> shipments = splitter.splitOrder(order, inventory);\n        assertAll(\n            () -> assertEquals(immediateItems.stream().sorted().toList(),\n                               productIdsWithTiming(shipments, IMMEDIATE)),\n            () -> assertEquals(deferredItems.stream().sorted().toList(),\n                               productIdsWithTiming(shipments, DEFERRED))\n        );\n    }\n\n    // -------------------------------------------------------------------------\n    // Minimise warehouse shipment count\n    // -------------------------------------------------------------------------\n\n    @DisplayName(\"Minimise warehouse shipment count\")\n    @Description(\"\"\"\n            When items can be fulfilled from multiple warehouses, choose the\n            combination that covers the order in the fewest shipments.\n            All items use DELIVERY to Main-St — fulfillment type and address do\n            not vary here.\n            Open: when two warehouse combinations tie on minimum shipment count,\n            how is the tie broken?\n            \"\"\")\n    @TableTest(\"\"\"\n            Scenario                                    | Items                                                                          | Inventory                                            | Shipment count? | Warehouses used?\n            Single warehouse covers all                 | PROD-A/DELIVERY/Main-St, PROD-B/DELIVERY/Main-St                               | WH1:PROD-A=5 PROD-B=5                                | 1               | [WH1]\n            Consolidating warehouse preferred           | PROD-A/DELIVERY/Main-St, PROD-B/DELIVERY/Main-St                               | WH1:PROD-A=5; WH2:PROD-A=3 PROD-B=3; WH3:PROD-B=5   | 1               | [WH2]\n            Two warehouses needed when none covers all  | PROD-A/DELIVERY/Main-St, PROD-B/DELIVERY/Main-St                               | WH1:PROD-A=5; WH2:PROD-B=5                           | 2               | [WH1, WH2]\n            Optimal pair chosen over three warehouses   | PROD-A/DELIVERY/Main-St, PROD-B/DELIVERY/Main-St, PROD-C/DELIVERY/Main-St      | WH1:PROD-A=5 PROD-B=5; WH2:PROD-C=5; WH3:PROD-A=3   | 2               | [WH1, WH2]\n            \"\"\")\n    void minimisesWarehouseShipmentCount(Order order,\n                                         WarehouseInventory inventory,\n                                         int shipmentCount,\n                                         List<String> warehousesUsed) {\n        List<Shipment> shipments = splitter.splitOrder(order, inventory);\n        List<String> actualWarehouses = shipments.stream()\n                .map(Shipment::getWarehouseId)\n                .filter(Objects::nonNull)\n                .distinct()\n                .sorted()\n                .toList();\n        assertAll(\n            () -> assertEquals(shipmentCount, shipments.size()),\n            () -> assertEquals(warehousesUsed.stream().sorted().toList(), actualWarehouses)\n        );\n    }\n\n    // -------------------------------------------------------------------------\n    // Keep companion products together\n    // -------------------------------------------------------------------------\n\n    @DisplayName(\"Keep companion products together\")\n    @Description(\"\"\"\n            Companion products should ship from the same warehouse when possible.\n            Companion groups are indicated by a group suffix in the item format:\n            PROD/DELIVERY/address/G1 means PROD belongs to companion group G1.\n            All items use DELIVERY to Main-St; all inventory is in-stock.\n            Open: if companion items have mismatched availability (one in-stock,\n            one backordered), does the companion constraint or the availability\n            split take precedence?\n            \"\"\")\n    @TableTest(\"\"\"\n            Scenario                                       | Items                                                                                         | Inventory                                                    | Together?\n            Companions at single warehouse                 | CAM-BODY/DELIVERY/Main-St/G1, CAM-LENS/DELIVERY/Main-St/G1                                    | WH1:CAM-BODY=5 CAM-LENS=5                                    | true\n            Companions unavoidably separated               | CAM-BODY/DELIVERY/Main-St/G1, CAM-LENS/DELIVERY/Main-St/G1                                    | WH1:CAM-BODY=5; WH2:CAM-LENS=5                               | false\n            Shared warehouse preferred for companions      | CAM-BODY/DELIVERY/Main-St/G1, CAM-LENS/DELIVERY/Main-St/G1                                    | WH1:CAM-BODY=5; WH2:CAM-LENS=5; WH3:CAM-BODY=3 CAM-LENS=3   | true\n            Non-companion items don't disrupt companions   | CAM-BODY/DELIVERY/Main-St/G1, CAM-LENS/DELIVERY/Main-St/G1, TRIPOD/DELIVERY/Main-St          | WH1:CAM-BODY=5 CAM-LENS=5; WH2:TRIPOD=5                     | true\n            \"\"\")\n    void keepsCompanionsTogether(Order order, WarehouseInventory inventory, boolean together) {\n        List<Shipment> shipments = splitter.splitOrder(order, inventory);\n        assertEquals(together, companionsAreTogether(order, shipments));\n    }\n\n    // =========================================================================\n    // Type converters\n    // =========================================================================\n\n    /**\n     * Parses an order from comma-separated item specs.\n     * Item format: productId/FULFILLMENT_TYPE[/deliveryAddress[/companionGroupId]]\n     * Examples:\n     *   PROD-A/DELIVERY/Main-St\n     *   PROD-B/PICKUP\n     *   CAM-BODY/DELIVERY/Main-St/G1\n     */\n    @TypeConverter\n    public static Order parseOrder(String value) {\n        if (value == null || value.isBlank()) return new Order(List.of());\n        List<OrderItem> items = Arrays.stream(value.split(\",\\\\s*\"))\n                .map(OrderSplittingTest::parseOrderItem)\n                .toList();\n        return new Order(items);\n    }\n\n    private static OrderItem parseOrderItem(String spec) {\n        String[] parts = spec.trim().split(\"/\");\n        String productId = parts[0];\n        FulfillmentType type = FulfillmentType.valueOf(parts[1]);\n        String address = null;\n        String companionGroupId = null;\n        if (type == DELIVERY && parts.length >= 3) {\n            address = parts[2];\n            if (parts.length >= 4) companionGroupId = parts[3];\n        } else if (type == PICKUP && parts.length >= 3) {\n            companionGroupId = parts[2];\n        }\n        return new OrderItem(productId, 1, type, address, companionGroupId);\n    }\n\n    /**\n     * Parses warehouse inventory from semicolon-separated warehouse specs.\n     * Warehouse format: warehouseId:productId=qty [productId=qty ...]\n     * Stock values: integer (in-stock quantity), \"backordered\", or \"preorder\"\n     * Examples:\n     *   WH1:PROD-A=5 PROD-B=3\n     *   WH1:PROD-A=5; WH2:PROD-B=backordered PROD-C=preorder\n     */\n    @TypeConverter\n    public static WarehouseInventory parseInventory(String value) {\n        if (value == null || value.isBlank()) return new WarehouseInventory(Map.of());\n        Map<String, Map<String, StockLevel>> warehouses = new LinkedHashMap<>();\n        for (String warehouseSpec : value.split(\"\\\\s*;\\\\s*\")) {\n            String[] whParts = warehouseSpec.split(\":\", 2);\n            String warehouseId = whParts[0].trim();\n            Map<String, StockLevel> stock = new LinkedHashMap<>();\n            for (String productSpec : whParts[1].trim().split(\"\\\\s+\")) {\n                String[] kv = productSpec.split(\"=\", 2);\n                stock.put(kv[0], parseStockLevel(kv[1]));\n            }\n            warehouses.put(warehouseId, stock);\n        }\n        return new WarehouseInventory(warehouses);\n    }\n\n    private static StockLevel parseStockLevel(String value) {\n        return switch (value) {\n            case \"backordered\" -> StockLevel.backordered();\n            case \"preorder\"    -> StockLevel.preOrder();\n            default            -> StockLevel.inStock(Integer.parseInt(value));\n        };\n    }\n\n    // =========================================================================\n    // Helpers\n    // =========================================================================\n\n    /** A single warehouse (WH1) with all products from the order in stock. */\n    private WarehouseInventory fullyStocked(Order order) {\n        Map<String, StockLevel> stock = order.getItems().stream()\n                .collect(toMap(\n                    OrderItem::getProductId,\n                    item -> StockLevel.inStock(100),\n                    (a, b) -> a));\n        return new WarehouseInventory(Map.of(\"WH1\", stock));\n    }\n\n    /** Fixed two-item DELIVERY order (PROD-A and PROD-B to Main-St) used by Table 3. */\n    private Order twoItemDeliveryOrder() {\n        return new Order(List.of(\n            new OrderItem(\"PROD-A\", 1, DELIVERY, \"Main-St\", null),\n            new OrderItem(\"PROD-B\", 1, DELIVERY, \"Main-St\", null)\n        ));\n    }\n\n    private int countByType(List<Shipment> shipments, FulfillmentType type) {\n        return (int) shipments.stream()\n                .filter(s -> s.getFulfillmentType() == type)\n                .count();\n    }\n\n    private List<String> productIdsWithTiming(List<Shipment> shipments, ShipmentTiming timing) {\n        return shipments.stream()\n                .filter(s -> s.getTiming() == timing)\n                .flatMap(s -> s.getItems().stream())\n                .map(OrderItem::getProductId)\n                .sorted()\n                .toList();\n    }\n\n    /**\n     * Returns true if every companion group in the order has all its members\n     * in at least one common shipment.\n     */\n    private boolean companionsAreTogether(Order order, List<Shipment> shipments) {\n        Map<String, List<String>> groups = order.getItems().stream()\n                .filter(item -> item.getCompanionGroupId() != null)\n                .collect(groupingBy(\n                    OrderItem::getCompanionGroupId,\n                    mapping(OrderItem::getProductId, toList())));\n\n        return groups.values().stream().allMatch(companions ->\n            shipments.stream().anyMatch(s -> {\n                Set<String> inShipment = s.getItems().stream()\n                        .map(OrderItem::getProductId)\n                        .collect(toSet());\n                return inShipment.containsAll(companions);\n            })\n        );\n    }\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":139,"cache_read_input_tokens":82670,"cache_creation":{"ephemeral_5m_input_tokens":139,"ephemeral_1h_input_tokens":0},"output_tokens":65,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"daa31f69-3f3e-4049-9f17-1f40bf265251","uuid":"0fb03131-6106-4794-a350-b81a3510cf73"}
